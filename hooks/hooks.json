{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${LOCALAPPDATA}\\Programs\\PowerShell\\7\\pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/boot/ensure-built.ps1\" -Root \"${CLAUDE_PLUGIN_ROOT}\"",
            "async": false
          },
          {
            "type": "command",
            "command": "${LOCALAPPDATA}\\Programs\\PowerShell\\7\\pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/boot/lsp-patch.ps1\" -Mode check",
            "async": false
          },
          {
            "type": "command",
            "command": "${LOCALAPPDATA}\\Programs\\PowerShell\\7\\pwsh.exe -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/boot/lsp-banner.ps1\" -Root \"${CLAUDE_PLUGIN_ROOT}\"",
            "async": false
          }
        ]
      }
    ]
  }
}
