<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 keeps the exec path stable for .mcp.json / ensure-built.ps1. No longer constrained by in-process MSBuild
         (that machinery is gone — the tools call the shared Roslyn daemon over Sluice). -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeRoslynLsp.Mcp</AssemblyName>
    <RootNamespace>ClaudeRoslynLsp.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP protocol layer (stdio server + [McpServerTool] discovery). -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zero-serialization shared-memory IPC: the tools drive the ONE shared Roslyn daemon (the same warm workspace the
         LSP uses) over Sluice, instead of each agent's MCP loading its own MSBuildWorkspace (N× a full solution → 1×). -->
    <ProjectReference Include="../../___/external/Sluice/src/Sluice/Sluice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared bridge: workspace-discovery env var + the daemon connect/broker + the request/response LSP client. -->
    <Compile Include="../bridge/SolutionLocator.cs" Link="SolutionLocator.cs" />
    <Compile Include="../bridge/PipeKey.cs" Link="PipeKey.cs" />
    <Compile Include="../bridge/DaemonConnector.cs" Link="DaemonConnector.cs" />
    <Compile Include="../bridge/RoslynDaemonClient.cs" Link="RoslynDaemonClient.cs" />
  </ItemGroup>

</Project>
