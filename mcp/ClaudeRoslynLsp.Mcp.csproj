<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 keeps the exec path stable for .mcp.json / ensure-built.ps1. No longer constrained by in-process MSBuild
         (that machinery is gone — the tools call the shared Roslyn daemon over Sluice). -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeRoslynLsp.Mcp</AssemblyName>
    <RootNamespace>ClaudeRoslynLsp.Mcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- WORKSTATION GC (2026-09-22, @meshx). Live, the Server-GC proxies sat at ~230 MB private after ~60 min (one per
         agent session) while the net8 client, same relay job on workstation GC, sat at 10-16 MB. A/B on this binary:
         at initialize 29 MB / 51 threads (server) vs 13 MB / 17 threads (workstation); after 40 search_symbols calls
         101 MB / 54 threads vs 94 MB / 24 threads. A relay has no use for 32 heaps. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The MCP protocol layer (stdio server + [McpServerTool] discovery). -->
    <PackageReference Include="ModelContextProtocol" Version="0.4.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zero-serialization shared-memory IPC: the tools drive the ONE shared Roslyn daemon (the same warm workspace the
         LSP uses) over Sluice, instead of each agent's MCP loading its own MSBuildWorkspace (N× a full solution → 1×). -->
    <ProjectReference Include="$(ExternalRoot)/Sluice/src/Sluice/Sluice.csproj" />
    <!-- The system-agnostic extension contract + loader: repo-declared extensions (.claude-roslyn/extensions.json) that
         contribute MCP tools backed by a running system. The net8.0 contract loads fine into this net10.0 host. -->
    <ProjectReference Include="../extensions-api/ClaudeRoslynLsp.Extensions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared bridge: workspace-discovery env var + the daemon connect/broker + the request/response LSP client +
         the shared Roslyn operations (RoslynOps) and on-disk edit application (LspEdits) the CLI also drives. -->
    <Compile Include="../bridge/SolutionLocator.cs" Link="SolutionLocator.cs" />
    <Compile Include="../bridge/PipeKey.cs" Link="PipeKey.cs" />
    <Compile Include="../bridge/DaemonConnector.cs" Link="DaemonConnector.cs" />
    <Compile Include="../bridge/RoslynDaemonClient.cs" Link="RoslynDaemonClient.cs" />
    <Compile Include="../bridge/LspEdits.cs" Link="LspEdits.cs" />
    <Compile Include="../bridge/RoslynOps.cs" Link="RoslynOps.cs" />
    <!-- The ONE data-root resolver (CLAUDE_PLUGIN_DATA → ZILTCH_DATA_ROOT → Z:\DATA → throw; never AppData). Internal, so
         extensions-api's own linked copy stays invisible here and the two never collide. -->
    <Compile Include="../shared/PluginDataRoot.cs" Link="PluginDataRoot.cs" />
  </ItemGroup>

</Project>
