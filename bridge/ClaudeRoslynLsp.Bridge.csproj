<Project Sdk="Microsoft.NET.Sdk">

  <!-- The claude-roslyn-lsp BRIDGE: a small stdio LSP proxy that makes Microsoft's Roslyn language server
       (Microsoft.CodeAnalysis.LanguageServer) usable by a generic LSP client (Claude Code). It (1) acquires the
       per-platform Roslyn server binary on first run, (2) spawns it over stdio, (3) proxies LSP traffic, and
       (4) drives the Roslyn-specific solution/open notification that the server needs to actually load a workspace.
       Builds from source on the device (no prebuilt binary shipped). net8.0 keeps the floor broad. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClaudeRoslynLsp.Bridge</AssemblyName>
    <RootNamespace>ClaudeRoslynLsp.Bridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One self-contained dll on disk; the launcher runs it via `dotnet <dll>`. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- This directory is also the shared-primitives folder the hosts link from, and DaemonConnector.cs /
         RoslynDaemonClient.cs speak Sluice. Without this reference the project did not compile at all (CS0246 on
         `Sluice`, six errors) — nothing noticed because ensure-built.ps1 never builds the bridge. -->
    <ProjectReference Include="$(ExternalRoot)/Sluice/src/Sluice/Sluice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ONE data-root resolver (CLAUDE_PLUGIN_DATA → ZILTCH_DATA_ROOT → Z:\DATA → throw; never AppData), linked — never copied. -->
    <Compile Include="../shared/PluginDataRoot.cs" Link="PluginDataRoot.cs" />
  </ItemGroup>

</Project>
