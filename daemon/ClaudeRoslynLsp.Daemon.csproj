<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <!-- ConsoleAppFramework v5's generated CLI uses C# 13 language features (ref/unsafe in async). -->
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ClaudeRoslynLsp.Daemon</AssemblyName>
    <RootNamespace>ClaudeRoslynLsp.Daemon</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI surface via the VENDORED ConsoleAppFramework (___/external/consoleappframework), per the repo directive that
         anything on the command line uses it. It is a zero-dependency source generator (no runtime assembly) — referenced
         as an Analyzer with ReferenceOutputAssembly=false. It generates the arg parsing, help, and a Ctrl-C/SIGTERM-wired
         CancellationToken from RunDaemon's signature. -->
    <ProjectReference Include="../../___/external/consoleappframework/src/ConsoleAppFramework/ConsoleAppFramework.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Zero-serialization shared-memory IPC (erinloy/Sluice). The client↔daemon hop is a Sluice ShmFrameChannel —
         frame-native (IFrameChannel was designed for LSP's Content-Length messages), zero-copy, faster than the
         named pipe it replaces. Vendored submodule under ___/external; this is its first in-repo consumer. -->
    <ProjectReference Include="../../___/external/Sluice/src/Sluice/Sluice.csproj" />
    <!-- The system-agnostic extension contract: repo-declared extensions (.claude-roslyn/extensions.json) can augment a
         file's diagnostics / hover with live state from a running system they dial out to (IDiagnosticExtension/IHoverExtension). -->
    <ProjectReference Include="../extensions-api/ClaudeRoslynLsp.Extensions.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One source of truth — reuse the verified bridge primitives (acquire LS, spawn, discover solution, LSP framing). -->
    <Compile Include="../bridge/JsonRpc.cs" Link="JsonRpc.cs" />
    <Compile Include="../bridge/SolutionLocator.cs" Link="SolutionLocator.cs" />
    <Compile Include="../bridge/RoslynAcquirer.cs" Link="RoslynAcquirer.cs" />
    <Compile Include="../bridge/RoslynServer.cs" Link="RoslynServer.cs" />
    <Compile Include="../bridge/PipeKey.cs" Link="PipeKey.cs" />
    <Compile Include="../bridge/LspEdits.cs" Link="LspEdits.cs" /> <!-- uri↔path for extension diagnostic augmentation -->
  </ItemGroup>

  <ItemGroup>
    <Using Include="ClaudeRoslynLsp.Extensions" />
  </ItemGroup>

</Project>
